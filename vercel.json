{
  "installCommand": "npm install",
  "buildCommand": "node scripts/generate-manifest.js",
  "git": {
    "deploymentEnabled": {
      "main": true
    }
  },
  "rewrites": [
    { "source": "/blog", "destination": "/blog/index.html" }
  ],
  "crons": [
    {
      "path": "/api/cron/expire-ads",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/weekly-report",
      "schedule": "0 15 * * 1"
    }
  ]
}
